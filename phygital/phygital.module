<?php

/**
 * @file
 * Contains figital.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function phygital_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the figital module.
    case 'help.page.figital':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('modulo custom figital') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_library_info_alter().
 *
 * Exposes the public 'js' section of phygital.settings.php as
 * drupalSettings.phygital. Credentials are never sent to the browser.
 */
function phygital_library_info_alter(&$libraries, $extension) {
  $settings_file = __DIR__ . '/phygital.settings.php';
  if ($extension !== 'phygital' || !file_exists($settings_file)) {
    return;
  }
  $settings = require $settings_file;
  foreach ($libraries as $name => &$library) {
    if ($name !== 'leafletlib') {
      $library['drupalSettings']['phygital'] = $settings['js'];
    }
  }
}

/**
 * Implements hook_theme().
 */
function phygital_theme() {
  return [
    'phygital_custom_page' => [
      'render element' => 'children',
      'variables' => ['test_var' => NULL],
    ],
    'phygital_itinerari' => [
      'render element' => 'children',
      'variables' => ['test_var' => NULL],
    ],
    'phygital_itinerario' => [
      'render element' => 'children',
      'variables' => [
        'test_var' => NULL,
        'lng' => NULL,
      ],
    ],	
    'phygital_benvenuto' => [
      'render element' => 'children',
      'variables' => ['test_var' => NULL],
    ],
	  'phygital_creaitinerario' => [
      'render element' => 'children',
      'variables' => [
        'test_var' => NULL,
        'lng' => NULL,
        ],
    ],
	  'phygital_creaitinerario_comune' => [
      'render element' => 'children',
      'variables' => ['test_var' => NULL],
    ],
  ];
}
